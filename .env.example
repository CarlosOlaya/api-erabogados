CORS_ORIGINS=https://app-erabogados.vercel.app,https://propuestas.erabogados.co
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erabogados
DB_SSL=false
DB_POOL_MAX=5
# Clave del estudio. Protege el registro corporativo y TODAS las rutas de
# propuestas (listar, crear, editar, publicar, eliminar). Sin ella la API
# rechaza el acceso administrativo: nunca lo deja abierto.
ER_ADMIN_TOKEN=defina-un-token-largo-y-privado
# Deploy Hooks de Vercel: opcionales en local, obligatorios para sincronía automática.
LANDING_DEPLOY_HOOK=
PORTAL_DEPLOY_HOOK=
# Aviso al equipo cuando un cliente abre su portal. Acepta cualquier webhook
# que reciba JSON (Slack, Make, n8n). Vacío = sin avisos.
PORTAL_NOTIFY_WEBHOOK=
